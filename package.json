	},
	"devDependencies": {
		"@biomejs/biome": "2.3.11",
		"@codama/renderers-js": "^1.5.5",
		"@codama/nodes-from-anchor": "^1.3.8",
		"@codama/renderers-rust": "^1.2.9",
		"@types/bun": "latest",
		"@types/node": "^25.0.6",
		"codama": "^1.5.0",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
