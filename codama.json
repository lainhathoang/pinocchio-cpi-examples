{
	"idl": "./idl/dexs.json",
	"before": [],
	"scripts": {
		"js": {
			"from": "@codama/renderers-js",
			"args": ["clients/dexs/js/src/generated"]
		},
		"rust": {
			"from": "@codama/renderers-rust",
